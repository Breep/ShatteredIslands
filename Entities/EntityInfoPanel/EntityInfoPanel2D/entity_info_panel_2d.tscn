    float avg_aa = (pixel_size_uv.x + pixel_size_uv.y) * 0.5;
    float rounded_mask = 1.0 - smoothstep(0.0, avg_aa * 1.5, dist_to_rounded_edge);

    // On multiplie l'alpha final par ce masque pour découper les coins
