[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, shadows_disabled;

uniform vec2 Speed_XY_Mask;
uniform sampler2D Texture_mask : source_color, hint_default_black, filter_linear;
uniform float Mask_power = 1;
uniform sampler2D TMask_Multiply : source_color, filter_linear;
uniform float Texture1_Zoom = 1;
uniform float Texture1_repeat = 1;
uniform vec2 Speed_XY_Polar;
uniform sampler2D Texture1_polar : source_color, filter_linear;
uniform float Texture1_power = 1;



void fragment() {
// Input:32
	vec4 n_out32p0 = COLOR;


// Input:24
	vec4 n_out24p0 = COLOR;
	float n_out24p4 = n_out24p0.a;


	vec2 n_out9p0;
// UVPolarCoord:9
	vec2 n_in9p1 = vec2(0.50000, 0.50000);
	float n_in9p2 = 1.00000;
	float n_in9p3 = 1.00000;
	{
		vec2 __dir = UV - n_in9p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out9p0 = vec2(__radius * n_in9p2, __angle * n_in9p3);
	}


// Vector2Parameter:11
	vec2 n_out11p0 = Speed_XY_Mask;


// VectorOp:12
	vec2 n_out12p0 = n_out11p0 * vec2(n_out24p4);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out12p0 * n_in8p1 + n_out9p0;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture_mask, n_out8p0);
	float n_out5p1 = n_out5p0.r;


// SmoothStep:29
	float n_in29p1 = 1.00000;
	float n_out29p0 = smoothstep(n_out24p4, n_in29p1, n_out5p1);


// FloatParameter:21
	float n_out21p0 = Mask_power;


// FloatOp:20
	float n_out20p0 = pow(n_out29p0, n_out21p0);


	vec4 n_out26p0;
// Texture2D:26
	n_out26p0 = texture(TMask_Multiply, UV);
	float n_out26p1 = n_out26p0.r;


// FloatOp:25
	float n_out25p0 = n_out20p0 * n_out26p1;


// FloatParameter:22
	float n_out22p0 = Texture1_Zoom;


// FloatParameter:23
	float n_out23p0 = Texture1_repeat;


	vec2 n_out13p0;
// UVPolarCoord:13
	vec2 n_in13p1 = vec2(0.50000, 0.50000);
	{
		vec2 __dir = UV - n_in13p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out13p0 = vec2(__radius * n_out22p0, __angle * n_out23p0);
	}


// Vector2Parameter:14
	vec2 n_out14p0 = Speed_XY_Polar;


// Input:15
	float n_out15p0 = TIME;


// VectorOp:16
	vec2 n_out16p0 = n_out14p0 * vec2(n_out15p0);


// UVFunc:17
	vec2 n_in17p1 = vec2(1.00000, 1.00000);
	vec2 n_out17p0 = n_out16p0 * n_in17p1 + n_out13p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture1_polar, n_out17p0);
	float n_out3p1 = n_out3p0.r;


// FloatParameter:19
	float n_out19p0 = Texture1_power;


// FloatOp:18
	float n_out18p0 = pow(n_out3p1, n_out19p0);


// FloatOp:7
	float n_out7p0 = n_out25p0 - n_out18p0;


// Clamp:28
	float n_in28p1 = 0.00000;
	float n_in28p2 = 1.00000;
	float n_out28p0 = clamp(n_out7p0, n_in28p1, n_in28p2);


// Output:0
	ALBEDO = vec3(n_out32p0.xyz);
	ALPHA = n_out28p0;


}
"
