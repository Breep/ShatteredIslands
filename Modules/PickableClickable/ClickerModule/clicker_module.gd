class_name ClickerModule
extends Node

# ============================== Local node ==============================

@export var _camera: Camera3D

# ============================== Configuration ==============================

@export var _clickable_collider_mask: int = 16

# ============================== Configuration ==============================

@export var _debug: bool
var _debug_raycast: MeshInstance3D  # Needs to be in the final scene
var _debug_impact: MeshInstance3D # Needs to be in the final scene

# ============================== Private variables ==============================

var _current_focus: Node3D # The object pointed by the cursor
var _previous_focus: Node3D # The previous object pointed by the cursor

var _pickable_overing: Node3D # The PICKABLE pointed by the cursor
var _pickable_overing_module: PickableModule # The PickableModule of the PICKABLE pointed by the cursor
var _pickable_selected: Node3D # The PICKABLE previously selected
#var _pickable_selected_module: PickableModule # The PickableModule of the PICKABLE previously selected

var _clickable_overing: Node3D # The CLICKABLE pointed by the cursor
var _clickable_overing_module: ClickableModule # The ClickableModule of the CLICKABLE pointed by the cursor
var _clickable_selected: Node3D # The CLICKABLE previously selected
var _clickable_selected_module: ClickableModule # The ClickableModule of the CLICKABLE previously selected

var _pickable_start_global_pos: Vector3
var _pickable_start_intersection # Start position of the intersection of the ray coming from camera to the _pickable_plane ( Can't be hard typed because it can either be a Vector3 or null)
var _pickable_plane: Plane # Plane generated by Vector3.UP (Normal) and pickable.global_position

var _tween: Tween

var _is_active: bool = false
var _force_inactive: bool = false

# ============================== Node base functions ==============================

func _input(event: InputEvent) -> void: # TODO Should be unhandled input but GUI is doing shit, need to check out that
	if not _is_active or _force_inactive: return
	_handle_pickable_select(event)
	_handle_pickable_movement(event)
	_handle_clickable_select(event)


# Raycast in the mouse direction
func _physics_process(_delta: float):
	if not _is_active or _force_inactive: return
	if _pickable_selected != null: return # Don't try to select an other clickable/pickable if there is a pickable already selected
	
	_previous_focus = _current_focus
	var ray_origin: Vector3 = _camera.global_position
	var ray_dir: Vector3 = _camera.project_ray_normal(get_viewport().get_mouse_position())
	var ray_end: Vector3 = ray_origin + ray_dir * 100
	var space_state: PhysicsDirectSpaceState3D = _camera.get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(ray_origin, ray_end)
	query.collision_mask = _clickable_collider_mask
	var result: Dictionary = space_state.intersect_ray(query)
	_update_debug_raycast(ray_origin, ray_end, result)
	if not result:
		if _clickable_overing_module != null: _clickable_overing_module.unfocus()
		_pickable_overing = null
		_clickable_overing = null
		_current_focus = null
	elif result.collider != null:
		_current_focus = result.collider
		if _previous_focus != null and _previous_focus != _current_focus:
			if _previous_focus.has_meta(ClickableModule.CLICKABLE_META):
				var clickable_module = _previous_focus.get_meta(ClickableModule.CLICKABLE_META)
				clickable_module.unfocus()
		if result.collider.has_meta(ClickableModule.CLICKABLE_META):
			_clickable_overing = result.collider
			_clickable_overing_module = _clickable_overing.get_meta(ClickableModule.CLICKABLE_META)
			_clickable_overing_module.focus()
		if result.collider.has_meta(PickableModule.PICKABLE_META):
			_pickable_overing = result.collider
			_pickable_overing_module = _pickable_overing.get_meta(PickableModule.PICKABLE_META)


func _ready() -> void:
	if _camera == null:
		printerr("ClickerModule: Need to be attached to a camera [", get_path(), "]")
		_force_inactive = true
		return
	
	if _debug:
		_build_debug_meshs()

# ============================== Public functions ==============================

func set_active() -> void:
	if _is_active: return
	_is_active = true


func set_inactive() -> void:
	if not _is_active: return
	_is_active = false

# ============================== Private functions ==============================

func _handle_clickable_select(event: InputEvent) -> void:
	if event.is_action_pressed("select_main"):
		if _clickable_selected != null and _clickable_overing != _clickable_selected:
			_clickable_selected_module.unselect()
			_clickable_selected = null
			_clickable_selected_module = null
		if _clickable_overing != null:
			_clickable_overing_module.select()
			_clickable_selected = _clickable_overing
			_clickable_selected_module = _clickable_overing_module


func _handle_pickable_select(event: InputEvent) -> void:
	if event.is_action_pressed("select_secondary") and _pickable_overing != null:
		_select_pickable(_pickable_overing, true, event)
	elif event.is_action_released("select_secondary") and _pickable_selected != null:
		_select_pickable(_pickable_selected, false, event)


func _handle_pickable_movement(event: InputEvent) -> void:
	if _pickable_selected == null or _pickable_plane == null: return
	if event is InputEventMouseMotion:
		var from: Vector3 = _camera.project_ray_origin(event.position)
		var to: Vector3 = from + _camera.project_ray_normal(event.position) * 1000
		var pickable_intersection = _pickable_plane.intersects_ray(from, to)
		if pickable_intersection != null and _pickable_start_intersection != null:
			var delta: Vector3 = pickable_intersection - _pickable_start_intersection
			_pickable_selected.global_position.x = _pickable_start_global_pos.x + delta.x
			_pickable_selected.global_position.z = _pickable_start_global_pos.z + delta.z


func _select_pickable(pickable: Node3D, is_selected: bool, event: InputEvent) -> void:
	if not pickable.has_meta(PickableModule.PICKABLE_META):
		printerr("CenterPointCamera: Trying to pick a non pickable object ! [", pickable.name, "]")
		return
	
	var pickable_module: PickableModule = pickable.get_meta(PickableModule.PICKABLE_META)
	if _tween: _tween.kill()
	if is_selected:
		if pickable_module.pick() == false: return
		Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
		_pickable_selected = pickable
		_pickable_start_global_pos = pickable.global_position
		_pickable_plane = Plane(Vector3.UP, pickable.global_position)
		if _pickable_plane == null: return
		var from: Vector3 = _camera.project_ray_origin(event.position)
		var to: Vector3 = from + _camera.project_ray_normal(event.position) * 1000
		_pickable_start_intersection = _pickable_plane.intersects_ray(from, to) # TODO Move this inside the pickable module probably
		_tween = create_tween()
		_tween.tween_property(pickable, "position:y", 0.5, 0.2).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)
	else:
		if pickable_module.drop() == false: return
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		_pickable_selected = null
		_tween = create_tween()
		_tween.tween_property(pickable, "position:y", 0, 0.2).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_IN)


func _interact_clickable(clickable: Node3D) -> void:
	if not clickable.has_meta(ClickableModule.CLICKABLE_META):
		printerr("CenterPointCamera: Trying to interact with a non clickable object ! [", clickable.name, "]")
		return
	
	var clickable_module: ClickableModule = clickable.get_meta(ClickableModule.CLICKABLE_META)
	clickable_module.interact()


# ============================== DEBUG ==============================

func _build_debug_meshs() -> void:
	_build_impact_mesh()
	_build_raycast_mesh()


func _build_impact_mesh() -> void:
	_debug_impact = MeshInstance3D.new()
	
	var sphere_mesh := SphereMesh.new()
	sphere_mesh.radius = 0.1
	sphere_mesh.height = 0.2
	sphere_mesh.radial_segments = 16
	sphere_mesh.rings = 8
	
	var material := StandardMaterial3D.new()
	material.albedo_color = Color(1.0, 0.4, 0.7) # Pink
	
	sphere_mesh.material = material
	_debug_impact.mesh = sphere_mesh
	_debug_impact.name = "ClickerModule_DebugImpact" + str(get_instance_id())


func _build_raycast_mesh() -> void:
	_debug_raycast = MeshInstance3D.new()
	_debug_raycast.mesh = ImmediateMesh.new()
	_debug_raycast.name = "ClickerModule_DebugRaycast" + str(get_instance_id())


func _update_debug_raycast(origin: Vector3, end: Vector3, hit: Dictionary) -> void:
	if not _debug: return
	
	if not _debug_impact.is_inside_tree():
		get_tree().root.add_child(_debug_impact)
	if not _debug_raycast.is_inside_tree():
		get_tree().root.add_child(_debug_raycast)
	
	var mesh: ImmediateMesh = _debug_raycast.mesh
	mesh.clear_surfaces()
	mesh.surface_begin(Mesh.PRIMITIVE_LINES)
	mesh.surface_add_vertex(origin)
	mesh.surface_add_vertex(end)
	mesh.surface_end()
	
	if not hit.is_empty():
		_debug_impact.global_position=hit.position
