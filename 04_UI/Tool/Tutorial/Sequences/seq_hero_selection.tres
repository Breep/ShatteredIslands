[gd_resource type="Resource" script_class="TutorialSequence" load_steps=4 format=3]

[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_welcome"]
script = ExtResource("2_step")
id = &"welcome"
text = "Bienvenue aux Îles Brisées ! Je suis Braise. Le jeu TV va bientôt commencer. Choisis vite ton héros et rejoins-nous ! Chacun a un style unique avec son propre arbre de talents personnalisable."
target_unique_name = &""
validation_event = 0
validation_filter = &""
auto_advance_delay = 12.0

[resource]
script = ExtResource("1_seq")
id = &"seq_hero_selection"
trigger_state = 1
steps = Array[ExtResource("2_step")]([SubResource("step_welcome")])
