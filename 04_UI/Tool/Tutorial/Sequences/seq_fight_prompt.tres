[gd_resource type="Resource" script_class="TutorialSequence" load_steps=4 format=3]

[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_fight_prompt"]
script = ExtResource("2_step")
id = &"fight_prompt"
text = "C'est l'heure ! Clique sur Prochain combat pour démarrer le combat."
target_unique_name = &"EndBuyingPhaseButton"
validation_event = 5
validation_filter = &""
auto_advance_delay = 0.0
popup_mode = 2

[resource]
script = ExtResource("1_seq")
id = &"seq_fight_prompt"
trigger_state = 0
steps = Array[ExtResource("2_step")]([SubResource("step_fight_prompt")])
