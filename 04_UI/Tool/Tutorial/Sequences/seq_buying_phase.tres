[gd_resource type="Resource" script_class="TutorialSequence" load_steps=8 format=3]

[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://04_UI/Tool/Tutorial/Resource/tutorial_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_buy_cards"]
script = ExtResource("2_step")
id = &"buy_cards"
text = "Achète des cartes pour te renforcer."
target_unique_name = &"CardContainer"
validation_event = 0
validation_filter = &""
auto_advance_delay = 6.0
highlight_target = true

[sub_resource type="Resource" id="step_gold"]
script = ExtResource("2_step")
id = &"buy_gold"
text = "Les cartes coûtent des golds. Tu peux consulter tes golds à tout moment ici."
target_unique_name = &"PlayerGoldHBox"
validation_event = 0
validation_filter = &""
auto_advance_delay = 5.0
highlight_target = true
preferred_arrow_side = 3

[sub_resource type="Resource" id="step_card_levels"]
script = ExtResource("2_step")
id = &"buy_card_levels"
text = "Chaque carte a une origine et une rareté. Achète plusieurs fois la même carte pour la monter de niveau."
target_unique_name = &"CardContainer"
validation_event = 0
validation_filter = &""
auto_advance_delay = 7.0
highlight_target = true

[sub_resource type="Resource" id="step_card_origins"]
script = ExtResource("2_step")
id = &"buy_card_origins"
text = "Achète plusieurs cartes de la même origine pour renforcer ses effets."
target_unique_name = &"CardContainer"
validation_event = 0
validation_filter = &""
auto_advance_delay = 6.0
highlight_target = true

[sub_resource type="Resource" id="step_reroll"]
script = ExtResource("2_step")
id = &"buy_reroll"
text = "Pas convaincu ? Tu peux reroll le shop contre de l'or."
target_unique_name = &"RefreshButton"
validation_event = 0
validation_filter = &""
auto_advance_delay = 5.0
highlight_target = true

[resource]
script = ExtResource("1_seq")
id = &"seq_buying_phase"
trigger_state = 3
steps = Array[ExtResource("2_step")]([SubResource("step_buy_cards"), SubResource("step_gold"), SubResource("step_card_levels"), SubResource("step_card_origins"), SubResource("step_reroll")])
