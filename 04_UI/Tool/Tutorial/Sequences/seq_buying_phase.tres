[gd_resource type="Resource" script_class="TutorialSequence" format=3 uid="uid://ckn4mtnicd4bt"]

[ext_resource type="Script" uid="uid://djpg3rddxno15" path="res://04_UI/Tool/Tutorial/Resource/tutorial_sequence.gd" id="1_seq"]
[ext_resource type="Script" uid="uid://jooqjtqqt21" path="res://04_UI/Tool/Tutorial/Resource/tutorial_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_open_shop"]
script = ExtResource("2_step")
id = &"open_shop"
text = "Ouvre la boutique pour découvrir tes cartes."
target_unique_name = &"OpenShopButton"
validation_event = 9
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
highlight_target = true

[sub_resource type="Resource" id="step_show_gold"]
script = ExtResource("2_step")
id = &"show_gold"
text = "Voici ton or. Les cartes coûtent 100 Golds — garde un œil dessus."
target_unique_name = &"PlayerGoldHBox"
auto_advance_delay = 0.0
popup_mode = 1
highlight_target = true
preferred_arrow_side = 3

[sub_resource type="Resource" id="step_buy_attack"]
script = ExtResource("2_step")
id = &"buy_attack"
text = "Prends cette carte : elle renforce ton attaque, elles infligent maintenant: Ignite. Un puissant effet de dégât sur la durée ! "
target_unique_name = &"CardContainer"
target_sub_name = &"VBoxContainer"
validation_event = 7
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
ensure_shop_open = true
highlight_target = true
highlight_padding = 8.0

[sub_resource type="Resource" id="step_buy_defense"]
script = ExtResource("2_step")
id = &"buy_defense"
text = "Celle-ci pour la défense : tes attaques te soignent."
target_unique_name = &"CardContainer"
target_sub_name = &"VBoxContainer2"
validation_event = 7
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
ensure_shop_open = true
highlight_target = true
highlight_padding = 8.0

[sub_resource type="Resource" id="step_buy_combo"]
script = ExtResource("2_step")
id = &"buy_combo"
text = "Et le combo : elle augmente ta vitesse d'attaque. Plus de soins et plus d'ignite !"
target_unique_name = &"CardContainer"
target_sub_name = &"VBoxContainer3"
validation_event = 7
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
ensure_shop_open = true
highlight_target = true
highlight_padding = 8.0

[sub_resource type="Resource" id="step_reroll"]
script = ExtResource("2_step")
id = &"reroll"
text = "Rien d'autre d'intéressant ici. Reroll la boutique pour voir de nouvelles cartes."
target_unique_name = &"RefreshButton"
validation_event = 8
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
ensure_shop_open = true
highlight_target = true

[sub_resource type="Resource" id="step_upgrade_attack"]
script = ExtResource("2_step")
id = &"upgrade_attack"
text = "La carte Attaque est revenue ! Rachète-la pour l'améliorer. Tu peux la monter jusqu'au niveau 5."
target_unique_name = &"CardContainer"
target_sub_name = &"VBoxContainer"
validation_event = 7
auto_advance_delay = 0.0
popup_mode = 1
hide_skip = true
ensure_shop_open = true
highlight_target = true
highlight_padding = 8.0

[sub_resource type="Resource" id="step_sell_card"]
script = ExtResource("2_step")
id = &"sell_card"
text = "Besoin d'or ? Tu peux revendre une carte : glisse-la depuis ta main vers la boutique pour récupérer quelques pièces."
validation_event = 0
auto_advance_delay = 0.0
ensure_shop_open = true
screen_anchor = 1

[sub_resource type="Resource" id="step_click_unit"]
script = ExtResource("2_step")
id = &"click_unit"
text = "Clique sur un ennemi pour ouvrir sa fiche."
validation_event = 1
auto_advance_delay = 0.0
hide_skip = true
ensure_shop_closed = true
hide_hand = true
lock_entity_sheet = true
screen_anchor = 1

[sub_resource type="Resource" id="step_show_spells"]
script = ExtResource("2_step")
id = &"show_spells"
text = "Et voici tous ses sorts. Clique dessus pour voir ce qu'ils font — tu peux inspecter n'importe quelle unité comme ça."
target_unique_name = &"SkillsContainer"
auto_advance_delay = 0.0
ensure_shop_closed = true
hide_hand = true
lock_entity_sheet = true
highlight_target = true
highlight_padding = 8.0
screen_anchor = 1

[sub_resource type="Resource" id="step_launch_fight"]
script = ExtResource("2_step")
id = &"launch_fight"
text = "Achète un maximum de cartes avant la bataille, les adversaires kobold sont coriaces ! Quand tu es prêt, lance le combat pour vivre ta première aventure."
target_unique_name = &"ContinueButton"
validation_event = 4
auto_advance_delay = 0.0

[resource]
script = ExtResource("1_seq")
id = &"seq_buying_phase"
trigger_state = 3
steps = Array[ExtResource("2_step")]([SubResource("step_open_shop"), SubResource("step_show_gold"), SubResource("step_buy_attack"), SubResource("step_buy_defense"), SubResource("step_buy_combo"), SubResource("step_reroll"), SubResource("step_upgrade_attack"), SubResource("step_sell_card"), SubResource("step_click_unit"), SubResource("step_show_spells"), SubResource("step_launch_fight")])
