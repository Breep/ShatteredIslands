[gd_resource type="Resource" script_class="TutorialSequence" format=3 uid="uid://ckn4mtnicd4bt"]

[ext_resource type="Script" uid="uid://djpg3rddxno15" path="res://04_UI/Tool/Tutorial/Resource/tutorial_sequence.gd" id="1_seq"]
[ext_resource type="Script" uid="uid://jooqjtqqt21" path="res://04_UI/Tool/Tutorial/Resource/tutorial_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_buy_cards"]
script = ExtResource("2_step")
id = &"buy_cards"
text = "Achète des cartes pour te renforcer."
target_unique_name = &"CardContainer"
auto_advance_delay = 10.0
highlight_target = true

[sub_resource type="Resource" id="step_gold"]
script = ExtResource("2_step")
id = &"buy_gold"
text = "Les cartes coûtent des golds. Tu peux consulter tes golds à tout moment ici."
target_unique_name = &"PlayerGoldHBox"
auto_advance_delay = 10.0
highlight_target = true
preferred_arrow_side = 3

[sub_resource type="Resource" id="step_card_level"]
script = ExtResource("2_step")
id = &"buy_card_level"
text = "Les étoiles indiquent le niveau de la carte. Achète plusieurs fois la même pour la monter."
target_unique_name = &"CardContainer"
target_sub_name = &"CurrentLevelContainer"
auto_advance_delay = 10.0
highlight_target = true

[sub_resource type="Resource" id="step_card_rarity"]
script = ExtResource("2_step")
id = &"buy_card_rarity"
text = "Les runes lumineuses sur le contour indiquent la rareté de la carte."
target_unique_name = &"CardContainer"
target_sub_name = &"Runes"
auto_advance_delay = 10.0
highlight_target = true

[sub_resource type="Resource" id="step_card_family"]
script = ExtResource("2_step")
id = &"buy_card_family"
text = "L'icône au centre représente la famille. Cumuler des cartes de la même famille renforce ses effets."
target_unique_name = &"CardContainer"
target_sub_name = &"FamilyIcon"
auto_advance_delay = 10.0
highlight_target = true
highlight_padding = 8.0

[sub_resource type="Resource" id="step_reroll"]
script = ExtResource("2_step")
id = &"buy_reroll"
text = "Pas convaincu ? Tu peux reroll le shop contre de l'or."
target_unique_name = &"RefreshButton"
auto_advance_delay = 10.0
highlight_target = true

[resource]
script = ExtResource("1_seq")
id = &"seq_buying_phase"
trigger_state = 3
steps = Array[ExtResource("2_step")]([SubResource("step_buy_cards"), SubResource("step_gold"), SubResource("step_card_level"), SubResource("step_card_rarity"), SubResource("step_card_family"), SubResource("step_reroll")])
