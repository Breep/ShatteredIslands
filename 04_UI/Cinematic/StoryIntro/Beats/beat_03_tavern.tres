[resource]
script = ExtResource("1_beat")
id = &"beat_03_tavern"
text = "[i]Brouhaha, rires, chopes qui s'entrechoquent.[/i]

[b]« Hé, l'étranger ! Bienvenue à bord ! »[/b]

[b]« Tu viens t'inscrire au Show ? Parfait, parfait. »[/b]

[b]« Assis-toi par là, je t'apporte un bon hydromel pour te mettre en jambe. »[/b]"
