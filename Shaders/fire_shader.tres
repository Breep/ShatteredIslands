[resource]
code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed;
uniform sampler2D Texture_Main : source_color, repeat_enable;
uniform sampler2D Texture_Add : source_color;
uniform sampler2D Texture_Multiply : source_color;
uniform sampler2D Texture_Substract : source_color;
uniform sampler2D Texture_Color_1D : source_color;



void fragment() {
// Vector2Parameter:26
	vec2 n_out26p0 = Scale;


// UVFunc:25
	vec2 n_in25p2 = vec2(0.00000, 0.00000);
	vec2 n_out25p0 = (UV - n_in25p2) * n_out26p0 + n_in25p2;


// Input:22
	float n_out22p0 = TIME;


// Vector2Parameter:23
	vec2 n_out23p0 = Speed;


// VectorOp:24
	vec2 n_out24p0 = vec2(n_out22p0) * n_out23p0;


// UVFunc:21
	vec2 n_in21p1 = vec2(1.00000, 1.00000);
	vec2 n_out21p0 = n_out24p0 * n_in21p1 + n_out25p0;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(Texture_Main, n_out21p0);
	float n_out14p1 = n_out14p0.r;


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(Texture_Add, UV);
	float n_out12p1 = n_out12p0.r;


// FloatOp:27
	float n_out27p0 = n_out14p1 + n_out12p1;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Texture_Multiply, UV);
	float n_out10p1 = n_out10p0.r;


// FloatOp:28
	float n_out28p0 = n_out27p0 * n_out10p1;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture_Substract, UV);
	float n_out3p1 = n_out3p0.r;


// FloatOp:29
	float n_out29p0 = n_out28p0 - n_out3p1;


// Clamp:30
	float n_in30p1 = 0.00000;
	float n_in30p2 = 1.00000;
	float n_out30p0 = clamp(n_out29p0, n_in30p1, n_in30p2);


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Texture_Color_1D, vec2(n_out30p0));
	float n_out6p4 = n_out6p0.a;


// Output:0
	COLOR.rgb = vec3(n_out6p0.xyz);
	COLOR.a = n_out6p4;


}
"
