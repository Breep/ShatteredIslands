; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectA"
config/tags=PackedStringArray("3d", "autobattler")
run/main_scene="res://TMP_MultiplayerStart.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameManager="*res://Scripts/Managers/game_manager.gd"
MultiplayerDeckManager="*res://Scripts/Managers/multiplayer_deck_manager.gd"
Utils="*res://Scripts/Lib/utils.gd"
TooltipManager="*res://Scripts/Managers/Global/tooltip_manager.gd"
Events="*res://Scripts/Managers/Global/events.gd"
RoundManager="*res://Scripts/Managers/round_manager.gd"
CameraManager="*res://Scripts/Managers/camera_manager.gd"
Shared="*res://Scripts/Lib/shared.gd"
PlayerManager="*res://Scripts/Managers/Global/player_manager.gd"
GlobalFightingManager="*res://Scripts/Managers/Global/global_fighting_manager.gd"

[display]

window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://Data/": "red",
"res://Resources/": "green",
"res://ResourcesBase/": "orange",
"res://Scenes/": "pink",
"res://Scripts/": "purple",
"res://Shaders/": "orange"
}

[global_group]

SPAWN_TEAM_1=""
SPAWN_TEAM_2=""
CHARACTER=""

