; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ShatteredIslands"
config/tags=PackedStringArray("3d", "autobattler")
run/main_scene="res://TMP_MultiplayerStart.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://hl4bi74ds0b0"

[autoload]

GameManager="*res://Managers/game_manager.gd"
MultiplayerDeckManager="*res://Managers/multiplayer_deck_manager.gd"
Utils="*res://Scripts/Lib/utils.gd"
TooltipManager="*res://Managers/Global/tooltip_manager.gd"
Events="*res://Managers/Global/events.gd"
RoundManager="*res://Managers/round_manager.gd"
Shared="*res://Scripts/Lib/shared.gd"
PlayerManager="*res://Managers/Global/player_manager.gd"
GlobalFightingManager="*res://Managers/Global/global_fighting_manager.gd"

[debug]

shapes/collision/shape_color=Color(0, 0.588235, 0.686275, 1)

[display]

window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://Data/": "red",
"res://Resources/": "green",
"res://ResourcesBase/": "orange",
"res://Scenes/": "pink",
"res://Scripts/": "purple",
"res://Shaders/": "orange",
"res://UI/": "blue",
"res://VFEZ-godot-main/": "gray"
}

[global_group]

WALL=""

