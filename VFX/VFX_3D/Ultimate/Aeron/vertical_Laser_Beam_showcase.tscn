[sub_resource type="GDScript" id="GDScript_beq87"]
resource_name = "laser_activator"
script/source = "@tool
extends Node

@export var my_num:int = 0:
	set(new_my_num):
		my_num = new_my_num
		self.play_all_animations(my_num)

func _ready() -> void:
	$misc/AnimationPlayer.play(\"Init\")
	
func _run():
	$misc/AnimationPlayer.play(\"Init\")

func play_all_animations(_num:int)->void:
	match _num:
		1:
			$VFX_PlasmaBeam_Blue.find_child(\"AnimationPlayer\").play(\"Init\")
		2:
			$VFX_PlasmaBeam_RED.find_child(\"AnimationPlayer\").play(\"Init\")
		3:
			$VFX_Vertical_Hell_Beam_Blue.find_child(\"AnimationPlayer\").play(\"Init\")
		4:
			$VFX_Vertical_Hell_Beam_Red.find_child(\"AnimationPlayer\").play(\"Init\")
		5:
			$VFX_YinYang_Beam.find_child(\"AnimationPlayer\").play(\"Init\")
"

