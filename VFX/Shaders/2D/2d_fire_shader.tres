[resource]
code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed;
uniform sampler2D Texture_Main : source_color, repeat_enable;
uniform sampler2D Texture_Add : source_color;
uniform sampler2D Texture_Multiply : source_color;
uniform sampler2D Texture_Substract : source_color;
uniform sampler2D Texture_Color_1D : source_color;



void fragment() {
// Vector2Parameter:23
	vec2 n_out23p0 = Scale;


// UVFunc:22
	vec2 n_in22p2 = vec2(0.00000, 0.00000);
	vec2 n_out22p0 = (UV - n_in22p2) * n_out23p0 + n_in22p2;


// Input:19
	float n_out19p0 = TIME;


// Vector2Parameter:20
	vec2 n_out20p0 = Speed;


// VectorOp:21
	vec3 n_out21p0 = vec3(n_out19p0) * vec3(n_out20p0, 0.0);


// UVFunc:18
	vec2 n_in18p1 = vec2(1.00000, 1.00000);
	vec2 n_out18p0 = vec2(n_out21p0.xy) * n_in18p1 + n_out22p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture_Main, n_out18p0);
	float n_out3p1 = n_out3p0.r;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(Texture_Add, UV);
	float n_out14p1 = n_out14p0.r;


// FloatOp:24
	float n_out24p0 = n_out3p1 + n_out14p1;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(Texture_Multiply, UV);


// FloatOp:25
	float n_out25p0 = n_out24p0 * n_out15p0.x;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Texture_Substract, UV);


// FloatOp:26
	float n_out26p0 = n_out25p0 - n_out16p0.x;


// Clamp:27
	float n_in27p1 = 0.00000;
	float n_in27p2 = 1.00000;
	float n_out27p0 = clamp(n_out26p0, n_in27p1, n_in27p2);


	vec4 n_out17p0;
// Texture2D:17
	n_out17p0 = texture(Texture_Color_1D, vec2(n_out27p0));
	float n_out17p4 = n_out17p0.a;


// Output:0
	COLOR.rgb = vec3(n_out17p0.xyz);
	COLOR.a = n_out17p4;


}
"
