[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Speed;
uniform sampler2D Texture_move;
uniform float Speed_divider = 10.0;
uniform sampler2D Gradient;
uniform sampler2D Texture_main;
uniform vec4 Color_Fire : source_color = vec4(4.000000, 0.800000, 0.000000, 1.000000);



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
		__mvm = __mvm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// Input:8
	vec2 n_out8p0 = UV;


// Input:13
	float n_out13p0 = TIME;


// Vector2Parameter:20
	vec2 n_out20p0 = Speed;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out13p0) * n_out20p0;


// UVFunc:12
	vec2 n_in12p1 = vec2(1.00000, 1.00000);
	vec2 n_out12p0 = n_out14p0 * n_in12p1 + UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Texture_move, n_out12p0);


// VectorDecompose:10
	float n_out10p0 = n_out2p0.x;
	float n_out10p1 = n_out2p0.y;
	float n_out10p2 = n_out2p0.z;
	float n_out10p3 = n_out2p0.w;


// FloatParameter:22
	float n_out22p0 = Speed_divider;


// FloatOp:11
	float n_out11p0 = n_out10p0 / n_out22p0;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Gradient, UV);


// VectorDecompose:18
	float n_out18p0 = n_out16p0.x;
	float n_out18p1 = n_out16p0.y;
	float n_out18p2 = n_out16p0.z;
	float n_out18p3 = n_out16p0.w;


// FloatOp:17
	float n_out17p0 = n_out11p0 * n_out18p0;


// VectorOp:9
	vec2 n_out9p0 = n_out8p0 + vec2(n_out17p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture_main, n_out9p0);


// ColorParameter:24
	vec4 n_out24p0 = Color_Fire;


// VectorOp:7
	vec4 n_out7p0 = n_out3p0 * n_out24p0;


// VectorDecompose:6
	float n_out6p0 = n_out3p0.x;
	float n_out6p1 = n_out3p0.y;
	float n_out6p2 = n_out3p0.z;
	float n_out6p3 = n_out3p0.w;


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out6p0;


}
