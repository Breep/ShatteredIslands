code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_5;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_4;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);
	float n_out5p1 = n_out5p0.r;


// Input:7
	float n_out7p0 = TIME;


// FloatOp:8
	float n_in8p1 = 1.00000;
	float n_out8p0 = n_out7p0 * n_in8p1;


// FloatFunc:6
	float n_out6p0 = sin(n_out8p0);


// Clamp:13
	float n_in13p1 = 0.20000;
	float n_in13p2 = 1.10000;
	float n_out13p0 = clamp(n_out6p0, n_in13p1, n_in13p2);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out13p0) * vec3(n_out3p0.xyz);


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ROUGHNESS = n_out5p1;
	EMISSION = n_out12p0;
	NORMAL_MAP = vec3(n_out4p0.xyz);


}
