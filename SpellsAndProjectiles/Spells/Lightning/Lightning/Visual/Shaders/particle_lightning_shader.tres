	float n_out2p1 = n_out2p0.r;


// SmoothStep:6
	float n_in6p1 = 1.00000;
	float n_out6p0 = smoothstep(n_out7p0.x, n_in6p1, n_out2p1);


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out6p0;


}
