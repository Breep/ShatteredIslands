code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 wave_color : source_color;
uniform sampler2D tex_frg_2;



void fragment() {
// ColorParameter:11
	vec4 n_out11p0 = wave_color;


// Input:3
	vec4 n_out3p0 = COLOR;


// VectorOp:4
	vec2 n_in4p1 = vec2(0.00000, 0.50000);
	vec2 n_out4p0 = vec2(n_out3p0.xy) * n_in4p1;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out4p0 * n_in5p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out5p0);
	float n_out2p1 = n_out2p0.r;


// ColorConstant:10
	vec4 n_out10p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// Input:8
	vec4 n_out8p0 = COLOR;


// ColorOp:9
	vec3 n_out9p0 = abs(vec3(n_out10p0.xyz) - vec3(n_out8p0.xyz));
	float n_out9p1 = n_out9p0.r;


// FloatOp:7
	float n_out7p0 = n_out2p1 * n_out9p1;


// Output:0
	ALBEDO = vec3(n_out11p0.xyz);
	ALPHA = n_out7p0;


}
